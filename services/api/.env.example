# Copy to services/api/.env. Never commit .env and never ship these values in
# the browser extension. The extension calls this backend, not Google.

# --- Gemma 4 intake (Gemini API) -----------------------------------------
# A fresh key from Google AI Studio. The key pasted in chat before this build
# must be treated as compromised and rotated.
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-31b-it
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMMA_TIMEOUT_SECONDS=45

# Local text fallback when no key is configured. It never reads images.
ALLOW_LOCAL_INTAKE=true

# --- Limits ---------------------------------------------------------------
MAX_IMAGE_BYTES=8000000
MAX_TEXT_CHARS=200000

# --- CORS -----------------------------------------------------------------
# The Vite dev server by default. chrome-extension://* is allowed by regex.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_ORIGIN_REGEX=chrome-extension://.*
