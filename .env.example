# Corrector backend environment (Milestone 2+).
# Copy to .env and fill in. NEVER commit .env, and NEVER ship these values
# inside the browser extension.

# --- Gemma intake (Gemini API) -------------------------------------------
# Server-side only. The extension calls our FastAPI backend, never Google.
GEMINI_API_KEY=
GEMMA_MODEL=

# --- Open reasoning model (vLLM, OpenAI-compatible) ----------------------
# Example: http://<gpu-droplet-ip>:8000/v1
REASONING_BASE_URL=
REASONING_MODEL=
REASONING_API_KEY=

# Local fallback while developing (Ollama exposes an OpenAI-compatible API).
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=

# --- Code runner ---------------------------------------------------------
# Piston or Judge0, self-hosted. User code never runs on the API host.
RUNNER_URL=
RUNNER_TOKEN=

# --- Backend -------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=chrome-extension://*
